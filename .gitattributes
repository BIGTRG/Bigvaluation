# Normalize line endings — repo stores LF, so Windows/Linux diffs stay clean.
* text=auto eol=lf

# Explicitly text
*.ts    text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# Binary — never normalize
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.pdf   binary
*.woff  binary
*.woff2 binary
