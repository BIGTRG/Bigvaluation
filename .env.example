# {{BRAND_NAME}} Valuation Suite — environment. Copy to `.env` and fill in.
# NEVER commit a real .env (see .gitignore). Rotate all secrets before deploy.

# --- Server ---
PORT=8787
NODE_ENV=production

# --- Database (§8) ---
# Unset DATABASE_URL to run with in-memory stores (dev only).
DATABASE_URL=postgres://flip:flip@localhost:5432/flipmaster
PGSSL=0
# Apply migrations automatically on boot (fine for a single box; use a real
# migration step in a multi-instance deploy).
MIGRATE_ON_BOOT=1

# --- Data providers (§6) ---
# When ATTOM_API_KEY is set, the server uses live data; otherwise the mock.
ATTOM_API_KEY=
HOUSECANARY_API_KEY=
HOUSECANARY_API_SECRET=

# --- Links ---
REPORTS_BASE_URL=https://reports.example.com
CAPTURE_BASE_URL=https://capture.example.com

# --- Dev seed key ---
# Seeds one partner API key on boot. Leave BLANK in production and provision
# keys out of band. Format: fmk_<keyId>.<secret>
SEED_API_KEY=fmk_demo.secret123

# --- Webhooks ---
WEBHOOK_MAX_ATTEMPTS=3

# --- Object storage (MinIO, §6) — used by the render/publish step when wired ---
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=reports
