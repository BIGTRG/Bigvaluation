# ValueProof Valuation Suite — environment. Copy to `.env` and fill in.
# NEVER commit a real .env (see .gitignore). Rotate all secrets before deploy.

# --- Server ---
PORT=8787
NODE_ENV=production

# --- Database (§8) ---
# Unset DATABASE_URL to run with in-memory stores (dev only).
DATABASE_URL=postgres://flip:flip@localhost:5432/flipmaster
PGSSL=0
# Apply migrations automatically on boot (fine for a single box; use a real
# migration step in a multi-instance deploy).
MIGRATE_ON_BOOT=1

# --- Data providers (§6) ---
# When ATTOM_API_KEY is set, the server uses live data; otherwise the mock.
ATTOM_API_KEY=
HOUSECANARY_API_KEY=
HOUSECANARY_API_SECRET=

# --- Vision / AI (§4.1) ---
# Claude condition scoring from property photos. Sonnet recommended for
# vision + structured output. Unset = callers must pass conditionScore manually.
ANTHROPIC_API_KEY=
# VISION_MODEL=claude-sonnet-4-20250514

# --- Links ---
REPORTS_BASE_URL=https://reports.example.com
CAPTURE_BASE_URL=https://capture.example.com

# --- Dev seed key ---
# Seeds one partner API key on boot. Leave BLANK in production and provision
# keys out of band. Format: fmk_<keyId>.<secret>
SEED_API_KEY=fmk_demo.secret123

# --- Webhooks ---
WEBHOOK_MAX_ATTEMPTS=3

# --- Web app ---
# Signing secret for dashboard sessions (>=16 chars). Unset = /app disabled.
SESSION_SECRET=change-me-32-chars-minimum-secret

# --- Stripe billing (§5) ---
# All four set = POST /billing/checkout + /billing/webhook enabled.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_REPORT=
STRIPE_PRICE_PRO_MONTHLY=
# Where Stripe Checkout returns the buyer:
BILLING_RETURN_URL=https://valueproof.net/billing

# --- AI rendering + staging (§4.4) ---
# Swappable vendor connector (REimagineHome / SofaBrain / Roomstage-style API).
# Both set = jobs with captured photos get renovation + staging renders.
RENDER_API_URL=
RENDER_API_KEY=

# --- PDF reports (§3) ---
# Gotenberg container URL; unset = GET /reports/:id?format=pdf returns 409.
GOTENBERG_URL=http://localhost:3000

# --- Live valuation monitoring (§5.3) ---
# Sweep interval in ms (86400000 = daily). 0 = off.
WATCH_INTERVAL_MS=86400000
WATCH_CHANGE_THRESHOLD=0.02

# --- Object storage (MinIO, §6) — used by the render/publish step when wired ---
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=reports
